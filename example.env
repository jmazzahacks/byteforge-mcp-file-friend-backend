# Local development only. Generate distinct random values before starting services.
FF_DATA_DIR=./data
FF_PUBLIC_URL=http://127.0.0.1:8081
FF_TUSD_URL=http://127.0.0.1:8080/files/
FF_HOOK_TOKEN=
FF_DEV_ADMIN_TOKEN=
FF_PORT=8081
# Provisional configurable limits, not deployment sizing decisions.
FF_MAX_SIZE=53687091200
FF_MIN_FREE_BYTES=1073741824
FF_MAX_ACTIVE=16
FF_INCOMPLETE_TTL=86400
FF_INCOMPLETE_MAX_AGE=604800
FF_RESERVATION_TTL=300
FF_RETENTION=604800
FF_WORKER_TIMEOUT=3600
FF_WORKER_GRACE=15
# PostgreSQL on Athena in production; localhost only for disposable validation.
FF_DB_HOST=localhost
FF_DB_PORT=5432
FF_DB_NAME=byteforge_file_friend
FF_DB_USER=byteforge_file_friend
FF_DB_PASSWORD=
FF_DB_SSLMODE=disable
FF_DB_POOL_SIZE=4
